{
    "include": [
        "./src/**/*"
    ],
    "compilerOptions": {
        "target": "es2018",
        "lib": [
            "dom",
            "dom.iterable",
            "es2018"
        ],
        "module": "esnext",
        "moduleResolution": "node",
        "jsx": "react-jsx",
        "strict": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "allowJs": true,
        "noEmit": true
    }
}
