# Copy this file to server/.env and fill it in. Nothing here is sent anywhere
# except to Google, Anthropic and your own mail provider.

# ---------------------------------------------------------------------------
# Google, for reading the receipt photos out of Google Photos.
# Create these at https://console.cloud.google.com/apis/credentials
# See README.md, section "Google Cloud setup".
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Anthropic, for reading the merchant, date and total off each photo.
# Create a key at https://console.anthropic.com/settings/keys
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
EXTRACT_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Email, for sending receipts straight into SAP Concur. Optional: without it
# you can still download the spreadsheet and the images.
# SMTP_FROM must be an address verified on the SAP Concur profile, otherwise
# Concur discards the message.
# For Gmail, create an app password at https://myaccount.google.com/apppasswords
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------------------------------------------------------------------------
# Local behaviour.
# ---------------------------------------------------------------------------
PORT=8787
APP_ORIGIN=http://localhost:3000
SERVER_ORIGIN=http://localhost:8787
DATA_DIR=./data
DEFAULT_CURRENCY=GBP
TIMEZONE=Europe/London
IMAGE_LONG_EDGE=2048
